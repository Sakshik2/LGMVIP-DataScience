/****************************The function ensures that the input voltage is within the defined range . ************************************/
float mapVoltageToPercentage(float voltage)
{
  // Clamp voltage to the range of minBatteryVoltage and maxBatteryVoltage
  // Ensure voltage does not go below the minimum battery voltage
  if (voltage < minBatteryVoltage)
    voltage = minBatteryVoltage;

  // Ensure voltage does not exceed the maximum battery voltage
  if (voltage > maxBatteryVoltage)
    voltage = maxBatteryVoltage;

  // Calculate the battery percentage based on clamped voltage
  // The percentage is calculated as the ratio of the current voltage
  // within the range of minBatteryVoltage to maxBatteryVoltage
  float percentage = (voltage - minBatteryVoltage) / (maxBatteryVoltage - minBatteryVoltage) * 100.0;
  // Return the calculated percentage
  return percentage;
}
/********************************* mapVoltageToPercentage(float voltage) function end *****************************************/

