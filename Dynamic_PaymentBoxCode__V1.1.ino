/******************************* Generating QR code with specified amount *****************************************************/
void generateAmountQRCode(String amount) {
  //  dwinSerial.write(ResetAmt, 11);                                              // resetting amount to 0 on display
  //  Serial.println("resetting amount");
  // Construct UPI payment link with dynamic amount
  String upiLink = "upi://pay?pa=" + upiID + "&pn=" + userName + "&am=" + amount + "&cu=" + currency;
  Serial.println(upiLink);

  uint8_t Vari[6] = {0x5A, 0xA5, 0x00, 0x82, 0x12, 0x00};
  char hexs[500];  // Array to store hex values as bytes
  int j = 0;

  for (int i = 0; i < upiLink.length(); i++) {
    sprintf(hexs + j, "%02X", upiLink[i]);                                          // Format each character as two hexadecimal digits without "0x"
    j += 2; // Each hex value is 2 characters long
  }
  hexs[j] = '\0';  // Null-terminate the string
  // Update the length byte in Vari1 to match the size of the data being sent
  Vari[2] = upiLink.length() + 6;                                                   // Adjust length for the DWIN display protocol

  // Send the header bytes
  dwinSerial.write(Vari, 6);

  // Send hex values as bytes
  for (int i = 0; i < strlen(hexs); i += 2) {
    // Convert each two-character hex pair back into a byte
    char hexPair[3] = {hexs[i], hexs[i + 1], '\0'};
    uint8_t byteValue = (uint8_t)strtol(hexPair, NULL, 16);
    dwinSerial.write(byteValue);                                                     // Send the byte over UART
  }
  dwinSerial.write(terminator, 3);

  memset(hexs, 0, sizeof(hexs));                                                     // Clear the hex string buffer

  //  Serial.println("Resetting value to '0'");
  //  dwinSerial.write(ResetAmt, 11);
}
/************************************* generateAmountQRCode(String amount) function end **************************************/

/************************************* Erasing text on DWIN display **********************************************************/
void eraseText(int vpaddress, int textLength) {
  dwinSerial.write(0x5A);
  dwinSerial.write(0xA5);
  dwinSerial.write(3 + textLength);
  dwinSerial.write(0x82);
  dwinSerial.write(lowByte(vpaddress));
  dwinSerial.write(highByte(vpaddress));

  for (int i = 0; i < textLength; i++) {
    dwinSerial.write((byte)0x20);                                                   // Clearing the text on display at given address
  }
}
/************************************* eraseText(int vpaddress, int textLength) function end *********************************/

/************************************* Generating default QR code ************************************************************/
void generateDefaultQrpage() {
  // Construct UPI payment link with dynamic amount
  String upiLink = "upi://pay?pa=" + upiID + "&pn=" + userName;
  //Serial.println(upiLink);

  uint8_t Vari[6] = {0x5A, 0xA5, 0x00, 0x82, 0X11, 0x00};
  char hexs[500];                                                                  // Array to store hex values as bytes
  int j = 0;

  for (int i = 0; i < upiLink.length(); i++) {
    sprintf(hexs + j, "%02X", upiLink[i]);                                         // Format each character as two hexadecimal digits without "0x"
    j += 2; // Each hex value is 2 characters long
  }
  hexs[j] = '\0';  // Null-terminate the string
                                                                                   // Update the length byte in Vari1 to match the size of the data being sent
  Vari[2] = upiLink.length() + 6;                                                  // Adjust length for the DWIN display protocol

  dwinSerial.write(Vari, 6);                                                       // Send the header bytes           

  // Send hex values as bytes
  for (int i = 0; i < strlen(hexs); i += 2) {
    char hexPair[3] = {hexs[i], hexs[i + 1], '\0'};                               // Convert each two-character hex pair back into a byte
    uint8_t byteValue = (uint8_t)strtol(hexPair, NULL, 16);
    dwinSerial.write(byteValue);                                                   // Send the byte over UART
  }
  dwinSerial.write(terminator, 3);                                                // sending terminator to avoid conflict for next QR
}
/********************************** generateDefaultQrpage() function end *****************************************************/

/********************************** Volume Adjustment Functions **************************************************************/
void setVolume(int volume) {
  volume = constrain(volume, 0, 100);                                               // Ensure volume is within range
  audio.setVolume(volume);
  Serial.printf("Volume set to: %d\n", volume);
}
/********************************** setVolume(int volume) function end *******************************************************/

/********************************** Function to increase volume **************************************************************/
void increaseVolume() {
  currentVolume += 10;
  dwinSerial.write(simulateTouch, 14);
  if (currentVolume > 100) currentVolume = 100;
  setVolume(currentVolume);
  sendTextAscii(0x58, String(currentVolume));                                        // Sending volume update on display
  sendTextAscii(0x59, "VOL");
  delay(1000);
  eraseText(0x58, 4);                                                                // Erasing volume update on display
  eraseText(0x59, 4);
}
/*********************************** increaseVolume() function end ************************************************************/

/*********************************** Function to decrease volume *************************************************************/
void decreaseVolume() {
  currentVolume -= 10;
  dwinSerial.write(simulateTouch, 14);
  if (currentVolume < 0) currentVolume = 0;
  setVolume(currentVolume);
  sendTextAscii(0x58, String(currentVolume));                                         // Sending volume update on display
  sendTextAscii(0x59, "VOL");
  delay(1000);
  eraseText(0x58, 4);                                                                 // Erasing volume on display
  eraseText(0x59, 4);
}
/*********************************** decreaseVolume() function end ************************************************************/

