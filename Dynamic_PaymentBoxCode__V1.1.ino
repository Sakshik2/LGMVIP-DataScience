  Serial.println("Process stareted");
  setPage(00);
  dwinSerial.write(simulateTouch, 14);
  battery_measurement();
  Serial.println(batperc);

  /************************* Checking battery charging status *******************************************/
  if (digitalRead(21) == LOW) {                   
    chargingOn = true;
    chargingStatus(chargingOn);
  }
  else if (digitalRead(21) == HIGH) {
    chargingOn = false;
    chargingStatus(chargingOn);
  }

  /********************Check for battery status***************************************/
  if (batperc < 17.00) {
    Serial.println("Entering in sleep mode!!!");

    esp_sleep_enable_timer_wakeup((TIME_TO_SLEEP * 60) * uS_TO_S_FACTOR);     // Wake up ESP32 after 5 minutes for checking battery status
    Serial.println("Low Battery, Entering sleep mode!!");
    setPage(11);
    Serial.flush();
    delay(2000);
    dwinSerial.write(offDisplay, 7);
    esp_deep_sleep_start();
  }
  

  Serial.println("## CODE IS STARTED NOW.............................");
