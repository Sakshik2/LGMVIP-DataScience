  /*********************setting RTC wakeup and printing wakeup cause**************************************/
  esp_sleep_enable_ext0_wakeup(GPIO_NUM_26, 0);                                // Seeting ext0 wakeup at RTC pin 26
  print_wakeup_reason();
  //Setting UNUSED GPIOs
