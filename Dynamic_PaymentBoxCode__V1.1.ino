/******************************** Displaying transaction on display ***********************************************************/
void displaytransaction() {
  getMsgcnt();
  String preTran = "";
  String res = "";

  // Define keys and ASCII mappings
  const char* timeKeys[5] = {"time1", "time2", "time3", "time4", "time5"};             // variables of time details
  const char* strKeys[5] = {"str1", "str2", "str3", "str4", "str5"};
  uint8_t timeAscii[5] = {0x36, 0x37, 0x38, 0x39, 0x40};                               // vp addresses of time
  uint8_t strAscii[5] = {0x22, 0x23, 0x24, 0x25, 0x26};

  // Predefined sequences for each Msg_cnt
  const int sequences[5][5] = {
    {0, 4, 3, 2, 1},                                                                  // Msg_cnt == 1
    {1, 0, 4, 3, 2},                                                                  // Msg_cnt == 2
    {2, 1, 0, 4, 3},                                                                  // Msg_cnt == 3
    {3, 2, 1, 0, 4},                                                                  // Msg_cnt == 4
    {4, 3, 2, 1, 0}                                                                   // Msg_cnt == 5
  };

  // Validate Msg_cnt range (1 to 5)
  if (Msg_cnt < 1 || Msg_cnt > 5) {
    Serial.println("Invalid Msg_cnt!");
    return;
  }

  // Display messages based on the sequence
  for (int i = 0; i < 5; i++) {
    int index = sequences[Msg_cnt - 1][i];

    res = pref.getString(timeKeys[index], preTran);                                  // getting time of transaction
    sendTextAscii(timeAscii[i], res);                                                // sending time
                       
    res = pref.getString(strKeys[index], preTran);                                   // getting transaction amount
    sendTextAscii(strAscii[i], currency + " " + res);                                // sending amount
  }
}
/**************************** displaytransaction() function end ***************************************************************/

/**************************** Configuring cellular module with AT commands ****************************************************/
void configModule() {
  Serial2.println("AT+CMGF=1");                                                       //Setting SMS mode
  updateSerial();
  Serial2.println("AT+QURCCFG=\"URCPORT\", \"UART1\"");                               //For UART communication
  updateSerial();
  Serial2.println("AT+CNMI=1,2,0,0,0");                                               //setting the message service to storage or not
  updateSerial();
  Serial2.println("AT+QSIMDET=1,0");                                                  //SIM detection, if SIM removed- +CPIN: NOT READY, SIM inserted- READY
  //  Serial2.println("AT+QSCLK=1");                                                  //enabling sleep mode
  //  updateSerial();
  Serial2.println("AT+QSCLKEX=1,2,5");                                                //enabling sleep mode
  updateSerial();
  Serial2.println("AT+QGPSEND");                                                      //disabling GPS
  updateSerial();
  Serial2.println("AT+QGPS?");                                                        //GPS STATUS
  updateSerial();
  Serial2.println("AT+CTZU=3");                                                       //Timing zone and reporting
  updateSerial();
  Serial2.println("AT+CCLK?");                                                        //Getting time
  updateSerial();
}
/***************************** configModule() function end ********************************************************************/
