    Button_flag = false;
    
    if(Msg_cnt>=1 && Msg_cnt <= 5) {
    readMsgs();                                                                     // reading previous transaction as per input 
    }                                                                        
    Button_cnt = 0;
    
  }

  if ((Button_flag != true) && (batperc > lowThreshold)) {
    if ((counter % 400) == 0) {                                                     // Checking network status
      networkStatus();
    }
  }

  /***************************** Battery monitoring ***************************************/
  if ((millis() - bat_cal) > 120000) {   
    detachInterrupt(36);
    detachInterrupt(39);// Battery calculation
    if (hmi.getPage() != 10 && countdownTime == 0 && hmi.getPage() != 03) {
      
      battery_measurement();
      displayBattery();
      bat_cal = millis();
      
    }
    attachInterrupt(36, increasePress, FALLING);
    attachInterrupt(39, decreasePress, FALLING);
  }

 /***************************** Battery charging status ************************************/
  if (digitalRead(21) == LOW && chargingOn == false) {
    chargingOn = true;
    chargingStatus(chargingOn);
    dwinSerial.write(simulateTouch, 14);
    Serial.println("Loop on");
  }
  else if (digitalRead(21) == HIGH && chargingOn == true) {
    chargingOn = false;
    chargingStatus(chargingOn);
    dwinSerial.write(simulateTouch, 14);
    Serial.println("Loop off");
  }

 /************************************* Battery monitoring as per percentage ******************************************/
  if (((checktp < counter) || (batperc < lowThreshold)) && (Button_flag != true) && (Serial2.available() <= 0)) {

    counter = 0;
    //battery_measurement();
    if (batperc < mediumThreshold)
    {
      checktp = 1000;
    }
    else if (batperc < fullThreshold)
    {
      checktp = 2000;
    }
    //Serial.print("ADC Value: ");
    //Serial.println(adcValue);
    Serial.print("Battery Percentage: ");
    Serial.print(batperc);
    Serial.println(" %");
    Serial.print("checktp: ");
    Serial.println(checktp);

    /*--------------------- // Determine the current battery status and print it ----------------------------------*/
    if (batperc < lowThreshold)
    {
      Serial.println("Battery is Low");
      lastBatteryStatus = "Battery is Low";
      setPage(07);                                                             //Setting low battery page
      battery_measurement();

      audioPlayer(1009);                                                       // Play low battery audio
      Serial.println("Playing low battery audio");
      displayBattery();
      delay(1000);

      setPage(18);                                                             // Setting default QR page
      generateDefaultQrpage();
      battery_measurement();

      Serial.println("Static QR  page displayed.");

      if (batperc < 15.00) {
        esp_sleep_enable_timer_wakeup((TIME_TO_SLEEP * 60) * uS_TO_S_FACTOR); // Wake up ESP32 after 5 minutes for checking battery status
        Serial.println("Low Battery, Entering sleep mode!!");
        setPage(11);                                                          //Setting shutting down page on display
        Serial.flush();
        delay(2000);
        dwinSerial.write(offDisplay, 7);
        esp_deep_sleep_start();
      }
    }
    else if (batperc >= fullThreshold)
    {
      if (lastBatteryStatus != "Battery is Full")
      {
        audioPlayer(1008);                                                    // Play full battery audio
        Serial.println("Playing full battery audio");
        Serial.println("Battery is Full");
        lastBatteryStatus = "Battery is Full";
      }
    }
    else
    {
      if (lastBatteryStatus != "")
      {
        Serial.println("Battery is in medium range");
        lastBatteryStatus = "";
      }
    }
  }




}


