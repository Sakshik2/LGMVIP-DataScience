    setPage(pageno);
    Serial2.println("AT");
    updateSerial();
    Serial2.println("AT+CFUN=1");                                                 // setting cellular to full functionality
    updateSerial();
    setPage(18);
    Serial.print("Checking BLE mode ");
    bleMode = pref.getBool("BLE", bleMode);
    Serial.println(bleMode);

    if (bleMode) {
      ble_init_param_set_fun();
    }
