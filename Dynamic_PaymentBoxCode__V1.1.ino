/************************** Receiving data from cellular ****************************************************/
void updateSerial() {
  int cmtstart = 0, cmtlast = 0, cmtmid = 0;                                                  //For multiple messages
  // Check if data is available to read from UART
  if (Serial2.available() > 0) {
    String receivedString = Serial2.readString();
    response = receivedString;
    Serial.println(response);

    cmtstart = response.indexOf("+CMT: ");
    cmtmid = response.indexOf("+CMT: ", cmtstart + 1);
    cmtlast = response.lastIndexOf("+CMT: ");

    const int length = response.length();                                                    // get the length of the text
    lower = (char*)malloc(length + 1);                                                       // allocate 'length' bytes + 1 (for null terminator) and cast to char*
    lower[length] = 0;                                                                       // set the last byte to a null terminator

    for (int i = 0; i < length; i++) {
      lower[i] = tolower(response[i]);
    }

    if ((strstr(lower, "upi")) || (strstr(lower, "ref"))) {                                 // Checking for UPI payments
      if ((strstr(lower, bankName.c_str()))) {
        if (cmtstart == cmtlast) {
          messageBuffer[index1] = response;
          Serial.print("Message stored at: "); Serial.println(index1);
          index1++;
        }
        else {
          messageBuffer[index1] = response;
          Serial.print("Message stored at: "); Serial.println(index1);
          index1++;

          while (cmtmid != cmtlast) {                                                        // Storing multiple message in buffer
            messageBuffer[index1] = response.substring(cmtmid);
            Serial.print("Message stored at: "); Serial.println(index1);
            index1++;
            cmtmid = response.indexOf("+cmt: ", cmtmid + 1);
          }
          messageBuffer[index1] = response.substring(cmtlast);
          Serial.print("Message stored at: "); Serial.println(index1);
          index1++;
        }
        messageBuffer[index1++] = "";
      }
    }

    if (messageBuffer[0] != "") {

      String msg = messageBuffer[0];                                                    // Processing messages stored in buffer

      int dateIndex = msg.indexOf(",\"") + 2;                                           // Find starting point of the date
      int timeIndex = msg.indexOf(",", dateIndex) + 1;                                  // Find starting point of the time

      date = msg.substring(dateIndex, dateIndex + 8);                                   // Extract date (YY/MM/DD)
      preTime = msg.substring(timeIndex, timeIndex + 8);                                // Extract time (HH:MM:SS)
      Serial.println(preTime + " on " + date);

      const int length1 = msg.length();                                                 // get the length of the text
      promsg = (char*)malloc(length1 + 1);                                              // allocate 'length' bytes + 1 (for null terminator) and cast to char*
      promsg[length1] = 0;                                                              // set the last byte to a null terminator

      for (int i = 0; i < length1; i++) {
        promsg[i] = tolower(msg[i]);
      }
      Serial.print("Whole Msg - ");
      Serial.println(promsg);

      Serial.println("\n");

      // Convert String to C-style stringString bankID_4=
      const char* bankIDCStr = bankID_4.c_str(); Serial.println("bankIDCStr: "); Serial.println(bankIDCStr);
      const char* bankNameCStr = bankName.c_str(); Serial.println("bankNameCStr: "); Serial.println(bankNameCStr);

      //final_amount = "";
      if ((strstr(promsg, bankNameCStr)))                                      //Check with bank
      {
        Serial.println(" BANK SMS ID IS VERIFIED");
        if ((strstr(promsg,  bankIDCStr)))                                     //Check with last 4 digit of bank account no with last 4 digit.
        {
          Serial.println(" BANK ACCOUNT IS VERIFIED");
          if ((strstr(promsg, "credited")) || (strstr(promsg, "debited")) || (strstr(promsg, "sent")) || (strstr(promsg, "received"))) //Check with credit/debit_keyword
          {
            Serial.println(" BANK AMOUNT CREDITED/DEBITED IS VERIFIED");
            if ((strstr(promsg, "rs ")) || (strstr(promsg, "rs.")) || (strstr(promsg, "inr ")) || (strstr(promsg, "rs:"))) //Check with currency_keyword
            {
              Serial.println(" BANK AMOUNT RS /RS./INR /RS:/ IS VERIFIED");
              Serial.print("Processing bank message: "); Serial.println(promsg);

              // Check for specific keywords in the lower string
              if (strstr(promsg, "rs "))                                        // If "rs " is found in lower
              {
                CheckWordInString_rs(promsg);                                   // Call the function to process the "rs " keyword
              }
              else if (strstr(promsg, "rs."))                                        // If "rs." is found in lower
              {
                CheckWordInString_rsDot(promsg);                                // Call the function to process the "rs." keyword
              }
              else if (strstr(promsg, "rs:"))                                        // If "rs:" is found in lower
              {
                CheckWordInString_rsCol(promsg);                                // Call the function to process the "rs:" keyword
              }
              else if (strstr(promsg, "inr "))                                       // If "inr " is found in lower
              {
                CheckWordInString_inrDot(promsg);                               // Call the function to process the "inr." keyword
              }

              saveMsgs();
              savetime();
              displaytransaction();
              dwinSerial.write(simulateTouch, 14);
              if ((countdownTime > 0) && (finalKeypadAmount != String(final_amount))) {     // Payment alert with audio
                Serial.println(finalKeypadAmount);
                Serial.print("final_amount=");
                Serial.println(final_amount);
                //delay(10);
                voice_commands(final_amount);
                //delay(10);
                Serial.println("Done with Voice commands. 1");
              }
              else {
                countdownTime = 0;
                setPage(05);                                                               //Setting received payment page
                dwinSerial.write(onDisplay, 7);
                sendTextAscii(CURRENT_PAY, currency + " " + String(final_amount));
                //delay(10);
                Serial.print("final_amount=");
                Serial.println(final_amount);
                voice_commands(final_amount);
                //delay(10);
                Serial.println("Done with Voice commands. 2");
                setPage(18);                                                               // Setting default QR page
                generateDefaultQrpage();
                Serial.println("Static QR  page displayed.");
              }
              if (messageBuffer[1] == "") {
                messageBuffer[0] = "";
                memset(messageBuffer, 0, sizeof(messageBuffer));
                index1 = 0;
              }
            }
          }
        }
      }
    }

    else if ((strstr(lower, "+cmti:  "))) {
      String result = (String)lower;
      int firstComma = result .indexOf("+cmti: "); Serial.println("firstComma"); Serial.println(firstComma);
      int secondComma = result .indexOf(','); Serial.println("secondComma"); Serial.println(secondComma);
      // Extract the csq from the received string
      String memory = result .substring(firstComma, secondComma);
      String strindex = result.substring(secondComma);
      Serial2.println("AT+CMGR=strindex");
    }

    else if ((strstr(lower, "+creg:")))                                                 //Check with "+CSQ"+CSQ: <rssi>,<ber>
    {
      if ((strstr(lower, " 0,1"))) {
        Serial.println("*************Network Connected*****************");
        if (!networkAvailable) {
          networkAvailable = true;
          displayNetwork(networkAvailable);
        }
      }
      else {
        Serial.println("*************Poor Connection*******************");
        if (networkAvailable) {
          networkAvailable = false;
          displayNetwork(networkAvailable);
        }
      }
    }

    else if ((strstr(lower, "+cpin:")))                                                        //Check with "+CPIN:READY"
    {
      if ((strstr(lower, "not")))
      {
        Serial.println("*****************SIM is not inserted ,Please check it. ************************");
        audioPlayer(1013);
      }
      else
      {
        Serial.println("*****************SIM is READY************************");
      }
    }


    for (int i = 0; i < BUFFER_SIZE - 1; i++) {                                              // Resetting buffer after processing message
      if (messageBuffer[i] == "") {
        index1 = i;
        break;
      }
      messageBuffer[i] = messageBuffer[i + 1];
      messageBuffer[i + 1] = "";
      if (index1 > 0) {
        index1--;
      }
    }


    // Clear variables for next iteration
    //response = "";
    // res = "";
    free(lower);                                                                           // freeing the memory of heap
    lower = NULL;
    promsg = "";
    msg = "";
  }
}
