/********************************* Sending text on DWIN display **************************************************************/
void sendTextAscii(int vpaddress, String s) {
  //eraseText(vpaddress, 100);
  unsigned char Vari[7] = {0x5A, 0xA5, 0x00, 0x82, vpaddress, (byte)0x00, 0x20};

  char hexs[500];                                                                 // Array to store hex values as bytes
  int j = 0;

  for (int i = 0; i < s.length(); i++) {
    sprintf(hexs + j, "%02X", s[i]);                                              // Format each character as two hexadecimal digits without "0x"
    j += 2;                                                                       // Each hex value is 2 characters long
  }
  hexs[j] = '\0';  // Null-terminate the string
  // Update the length byte in Vari1 to match the size of the data being sent
  Vari[2] = s.length() + 6;                                                       // Adjust length for the DWIN display protocol

  // Send the header bytes
  dwinSerial.write(Vari, 6);

  // Send hex values as bytes
  for (int i = 0; i < strlen(hexs); i += 2) {
    // Convert each two-character hex pair back into a byte
    char hexPair[3] = {hexs[i], hexs[i + 1], '\0'};
    uint8_t byteValue = (uint8_t)strtol(hexPair, NULL, 16);
    dwinSerial.write(byteValue);                                                    // Send the byte over UART
  }
  dwinSerial.write(terminator, 3);
  //memset(Vari, 0, sizeof(Vari));                                                  // clearing the buffer
}
/******************************** sendTextAscii(int vpaddress, String s) function end ****************************************/

